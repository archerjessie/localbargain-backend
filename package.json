{
  "name": "localbargain-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@redocly/cli": "^2.72.1",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^22.20.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && redocly lint openapi.yaml",
    "test": "vitest run --passWithNoTests",
    "build": "sam build --parallel --cached",
    "validate": "sam validate --lint",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "seed:local": "esbuild scripts/seed-local.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/seed-local.mjs --log-level=warning && node dist/seed-local.mjs",
    "test:sam-local": "vitest run --config vitest.sam-local.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1161.0",
    "@aws-sdk/client-dynamodb": "^3.1161.0",
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/client-ssm": "^3.1161.0",
    "@aws-sdk/lib-dynamodb": "^3.1161.0",
    "zod": "^4.6.7"
  }
}
